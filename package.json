{
  "name": "ai-director",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3010 --experimental-https --experimental-https-key .cert/lan-key.pem --experimental-https-cert .cert/lan.pem",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:integration": "tsx --conditions=react-server --test tests/integration/*.test.ts",
    "benchmark:evaluation": "tsx --conditions=react-server scripts/run-evaluation-benchmark.ts",
    "benchmark:trim": "tsx --conditions=react-server scripts/run-trim-benchmark.ts",
    "worker:render": "tsx --conditions=react-server scripts/final-render-worker.ts",
    "worker:materials": "tsx --conditions=react-server scripts/material-analysis-worker.ts",
    "fixtures:step10b:e2e": "tsx --conditions=react-server scripts/create-step10b-e2e-fixtures.ts",
    "benchmark:step10b:worker": "tsx --conditions=react-server scripts/run-step10b-worker-e2e.ts",
    "benchmark:event:v2": "tsx --conditions=react-server scripts/run-event-benchmark-v2.ts",
    "diagnose:material-provider": "tsx --conditions=react-server scripts/diagnose-material-provider.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "bgm:seed": "tsx --conditions=react-server scripts/seed-bgm.ts",
    "fixtures:stt:local": "tsx --conditions=react-server scripts/create-local-stt-fixtures.ts",
    "benchmark:stt:local": "tsx --conditions=react-server scripts/run-local-stt-benchmark.ts",
    "fixtures:final-qa": "tsx --conditions=react-server scripts/generate-final-qa-fixtures.ts",
    "benchmark:final-qa": "tsx --conditions=react-server scripts/run-final-qa-benchmark.ts",
    "render:step8:abc": "tsx --conditions=react-server scripts/render-step8-abc.ts",
    "smoke:step9": "tsx --conditions=react-server scripts/run-step9-smoke.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "^1.2.3",
    "bullmq": "^6.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "ffmpeg-static"
    ]
  }
}
